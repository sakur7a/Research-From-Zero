# Examples only. Do not put real credentials in a committed file.
# This file is NOT automatically loaded: export environment variables before run.py.
# Model settings may instead be entered in the UI and stay only in server memory.
# RE0_LLM_BASE_URL=https://<allowed-provider>/v1
# RE0_LLM_MODEL=<tool-calling-model-id>
# RE0_LLM_API_KEY=
# RE0_LLM_TOKEN_PARAMETER=max_tokens
# RE0_LLM_ALLOWED_HOSTS=your-trusted-gateway.example
# TAVILY_API_KEY=     # Optional web search snippets; separate from model key.
# GITHUB_TOKEN=       # Optional GitHub read token; only sent to api.github.com.
# RE0_DB=.data/re0.sqlite3
# RE0_HOST=127.0.0.1
# RE0_PORT=8000
# Explicit deployer-controlled stop for all new model requests; ordinary provider failures never set it.
# RE0_SITE_EMERGENCY_STOP=0
# Hosted deployments must explicitly set RE0_STORAGE_MODE=persistent or ephemeral-demo.
